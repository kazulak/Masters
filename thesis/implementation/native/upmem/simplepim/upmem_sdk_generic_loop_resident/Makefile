MAX_RANK ?= 16
MAX_ELEMS ?= 256
NR_TASKLETS ?= 1
PROFILE_VERSION ?= hardware_taskgraph_single_dpu_mram_resident_v1
COMPLETION_VERSION ?= 1
UPMEM_GENERIC_HARDWARE_MVP ?= 1
RESIDENT_MAX_LOGICAL_TASKS ?= 32
RESIDENT_MAX_COMPONENT_OPS ?= 128
RESIDENT_MAX_SLOT_DESCRIPTORS ?= 128
RESIDENT_MRAM_POOL_BYTES ?= 524288
RESIDENT_OUTPUT_TILE_ELEMS ?= 256
DPU_CC ?= dpu-upmem-dpurte-clang
HOST_CC ?= gcc

ifeq ($(filter $(NR_TASKLETS),1 2 4 8 16),)
$(error resident profile requires NR_TASKLETS in 1 2 4 8 16)
endif

ifneq ($(UPMEM_GENERIC_HARDWARE_MVP),1)
$(error resident profile requires UPMEM_GENERIC_HARDWARE_MVP=1; simulator builds are not valid evidence)
endif

.PHONY: all v1 v2 clean

all: v1

v1: bin/host bin/dpu_resident

bin:
	mkdir -p bin

bin/dpu_resident: dpu.c common.h | bin
	$(DPU_CC) -O2 -DRESIDENT_OPERATION_ABI_VERSION=1 -DNR_TASKLETS=$(NR_TASKLETS) -DRESIDENT_PROFILE_VERSION=\"$(PROFILE_VERSION)\" -DRESIDENT_COMPLETION_VERSION=$(COMPLETION_VERSION) -DUPMEM_GENERIC_HARDWARE_MVP=$(UPMEM_GENERIC_HARDWARE_MVP) -DUPMEM_GENERIC_MAX_RANK=$(MAX_RANK) -DUPMEM_GENERIC_MAX_ELEMS=$(MAX_ELEMS) -DRESIDENT_MAX_LOGICAL_TASKS=$(RESIDENT_MAX_LOGICAL_TASKS) -DRESIDENT_MAX_COMPONENT_OPS=$(RESIDENT_MAX_COMPONENT_OPS) -DRESIDENT_MAX_SLOT_DESCRIPTORS=$(RESIDENT_MAX_SLOT_DESCRIPTORS) -DRESIDENT_MRAM_POOL_BYTES=$(RESIDENT_MRAM_POOL_BYTES) -DRESIDENT_OUTPUT_TILE_ELEMS=$(RESIDENT_OUTPUT_TILE_ELEMS) -o $@ dpu.c

bin/host: host.c common.h session_protocol.c session_protocol.h | bin
	$(HOST_CC) -std=c99 -O2 -Wall -Wextra -DRESIDENT_OPERATION_ABI_VERSION=1 -DNR_TASKLETS=$(NR_TASKLETS) -DRESIDENT_PROFILE_VERSION=\"$(PROFILE_VERSION)\" -DRESIDENT_COMPLETION_VERSION=$(COMPLETION_VERSION) -DUPMEM_GENERIC_HARDWARE_MVP=$(UPMEM_GENERIC_HARDWARE_MVP) -DUPMEM_GENERIC_MAX_RANK=$(MAX_RANK) -DUPMEM_GENERIC_MAX_ELEMS=$(MAX_ELEMS) -DRESIDENT_MAX_LOGICAL_TASKS=$(RESIDENT_MAX_LOGICAL_TASKS) -DRESIDENT_MAX_COMPONENT_OPS=$(RESIDENT_MAX_COMPONENT_OPS) -DRESIDENT_MAX_SLOT_DESCRIPTORS=$(RESIDENT_MAX_SLOT_DESCRIPTORS) -DRESIDENT_MRAM_POOL_BYTES=$(RESIDENT_MRAM_POOL_BYTES) -DRESIDENT_OUTPUT_TILE_ELEMS=$(RESIDENT_OUTPUT_TILE_ELEMS) -o $@ host.c session_protocol.c $$(dpu-pkg-config --cflags --libs dpu)

bin/dpu_resident_v2: dpu.c common.h | bin
	$(DPU_CC) -O2 -DRESIDENT_OPERATION_ABI_VERSION=2 -DNR_TASKLETS=$(NR_TASKLETS) -DRESIDENT_PROFILE_VERSION=\"$(PROFILE_VERSION)\" -DRESIDENT_COMPLETION_VERSION=$(COMPLETION_VERSION) -DUPMEM_GENERIC_HARDWARE_MVP=$(UPMEM_GENERIC_HARDWARE_MVP) -DUPMEM_GENERIC_MAX_RANK=$(MAX_RANK) -DUPMEM_GENERIC_MAX_ELEMS=$(MAX_ELEMS) -DRESIDENT_MAX_LOGICAL_TASKS=$(RESIDENT_MAX_LOGICAL_TASKS) -DRESIDENT_MAX_COMPONENT_OPS=$(RESIDENT_MAX_COMPONENT_OPS) -DRESIDENT_MAX_SLOT_DESCRIPTORS=$(RESIDENT_MAX_SLOT_DESCRIPTORS) -DRESIDENT_MRAM_POOL_BYTES=$(RESIDENT_MRAM_POOL_BYTES) -DRESIDENT_OUTPUT_TILE_ELEMS=$(RESIDENT_OUTPUT_TILE_ELEMS) -o $@ dpu.c

bin/host_v2: host.c common.h session_protocol.c session_protocol.h | bin
	$(HOST_CC) -std=c99 -O2 -Wall -Wextra -DRESIDENT_OPERATION_ABI_VERSION=2 -DNR_TASKLETS=$(NR_TASKLETS) -DRESIDENT_PROFILE_VERSION=\"$(PROFILE_VERSION)\" -DRESIDENT_COMPLETION_VERSION=$(COMPLETION_VERSION) -DUPMEM_GENERIC_HARDWARE_MVP=$(UPMEM_GENERIC_HARDWARE_MVP) -DUPMEM_GENERIC_MAX_RANK=$(MAX_RANK) -DUPMEM_GENERIC_MAX_ELEMS=$(MAX_ELEMS) -DRESIDENT_MAX_LOGICAL_TASKS=$(RESIDENT_MAX_LOGICAL_TASKS) -DRESIDENT_MAX_COMPONENT_OPS=$(RESIDENT_MAX_COMPONENT_OPS) -DRESIDENT_MAX_SLOT_DESCRIPTORS=$(RESIDENT_MAX_SLOT_DESCRIPTORS) -DRESIDENT_MRAM_POOL_BYTES=$(RESIDENT_MRAM_POOL_BYTES) -DRESIDENT_OUTPUT_TILE_ELEMS=$(RESIDENT_OUTPUT_TILE_ELEMS) -o $@ host.c session_protocol.c $$(dpu-pkg-config --cflags --libs dpu)

v2: bin/host_v2 bin/dpu_resident_v2

clean:
	rm -rf bin
