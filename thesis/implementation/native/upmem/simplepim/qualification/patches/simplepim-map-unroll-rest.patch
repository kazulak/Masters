From: Thesis SimplePIM qualification
Subject: [PATCH] Fix self-referential map unroll remainder
Upstream-Status: Local correctness fix for pinned commit
 1d639c53532555f01e9f71d872e7712b166d6cba
Source: SimplePIM lib/processing/map/MapProcessing.h
License: Same terms as the pinned SimplePIM source (see upstream LICENSE)

Both map paths initialized unroll_block_rest by subtracting the variable
being initialized. Subtract the already-computed unrolled block size instead.
The runner applies this patch only to its staged workdir copy.

diff --git a/lib/processing/map/MapProcessing.h b/lib/processing/map/MapProcessing.h
--- a/lib/processing/map/MapProcessing.h
+++ b/lib/processing/map/MapProcessing.h
@@ -39,5 +39,5 @@ void map_dpu(__mram_ptr void* inputs, __mram_ptr void* outputs, uint32_t input_t
     uint32_t unroll_block_size = (copy_block_size>>2)<<2;
-    uint32_t unroll_block_rest = copy_block_size-unroll_block_rest;
-
+    uint32_t unroll_block_rest = copy_block_size-unroll_block_size;
+
     uint32_t i_init = pid<<copy_block_size_shiftbits;
     uint32_t i_elem = (uint32_t)inputs+i_init*elem_type_size;
@@ -171,5 +171,5 @@ void zip_map_dpu(__mram_ptr void* inputs1, __mram_ptr void* inputs2, __mram_ptr
     uint32_t unroll_block_size = (copy_block_size>>2)<<2;
-    uint32_t unroll_block_rest = copy_block_size-unroll_block_rest;
-
+    uint32_t unroll_block_rest = copy_block_size-unroll_block_size;
+
     if(input_type1 ==4 && input_type2 == 4){
         for(int i=pid*copy_block_size; i<divisible_len; i+=block_times_tasklets){
