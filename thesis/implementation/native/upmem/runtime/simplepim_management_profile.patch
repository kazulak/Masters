From: Thesis M4.1 provider seam
Subject: [PATCH] Add fail-closed physical profile to SimplePIM management
Upstream-Status: Local thesis adapter for pinned SimplePIM commit
 1d639c53532555f01e9f71d872e7712b166d6cba

The pinned SimplePIM management API allocates with a NULL profile. This
staged patch adds a separate entry point for the M4.1 physical route. The
original table_management_init API is unchanged. The new entry point rejects
all profiles except backend=hw, loads the supplied initialization binary, and
returns NULL on allocation, load, launch, or metadata failure.

diff --git a/lib/management/Management.h b/lib/management/Management.h
--- a/lib/management/Management.h
+++ b/lib/management/Management.h
@@ -49,11 +49,20 @@
 /*
    table_management_init initialise a management interface, can be called by end users
    add_table, contains_table, lookup_table, and free_table are used to retrieve information of an array from the management unit with its array id "name" (see the paper for detials)
    max_len_dpu is a helper function used by the framework
 */
 simplepim_management_t* table_management_init(uint32_t num_dpus);
+/* Thesis-owned physical-profile extension; the original API is unchanged. */
+simplepim_management_t* table_management_init_with_profile(
+    uint32_t num_dpus,
+    const char* allocation_profile,
+    const char* initialization_binary,
+    struct dpu_set_t* unreleased_set,
+    int* allocation_owned,
+    dpu_error_t* failure_error,
+    int* allocation_used,
+    int* release_attempted,
+    int* release_succeeded,
+    dpu_error_t* release_error_out
+);
 void add_table(table_host_t* table, simplepim_management_t* management);
 uint32_t contains_table(const char* name, simplepim_management_t* management);
 table_host_t* lookup_table(const char* name, simplepim_management_t* management);
 void free_table(const char* name, simplepim_management_t* management);
 uint32_t max_len_dpu(uint32_t num_dpus, table_host_t* table);
diff --git a/lib/management/Management.c b/lib/management/Management.c
--- a/lib/management/Management.c
+++ b/lib/management/Management.c
@@ -1,7 +1,86 @@
 #include "Management.h"

 /*
     see description of the functions in Management.h
 */

+static simplepim_management_t* management_from_set(
+    struct dpu_set_t set,
+    uint32_t num_dpus
+) {
+    simplepim_management_t* management = calloc(1, sizeof(simplepim_management_t));
+    if (management == NULL) return NULL;
+    management->set = set;
+    management->num_dpus = num_dpus;
+    management->num_tables = 0;
+    management->curr_space = 16;
+    management->tables = calloc(16, sizeof(table_host_t*));
+    management->zip_args = calloc(num_dpus, sizeof(zip_arguments_t));
+    management->map_args = calloc(num_dpus, sizeof(map_arguments_t));
+    management->red_args = calloc(num_dpus, sizeof(gen_red_arguments_t));
+    management->free_space_start_pos = 0;
+    if (management->tables == NULL || management->zip_args == NULL ||
+        management->map_args == NULL || management->red_args == NULL) {
+        free(management->tables);
+        free(management->zip_args);
+        free(management->map_args);
+        free(management->red_args);
+        free(management);
+        return NULL;
+    }
+    return management;
+}
+
+simplepim_management_t* table_management_init_with_profile(
+    uint32_t num_dpus,
+    const char* allocation_profile,
+    const char* initialization_binary,
+    struct dpu_set_t* unreleased_set,
+    int* allocation_owned,
+    dpu_error_t* failure_error,
+    int* allocation_used,
+    int* release_attempted,
+    int* release_succeeded,
+    dpu_error_t* release_error_out
+) {
+    struct dpu_set_t set = {0};
+    dpu_error_t error;
+    dpu_error_t release_error;
+    if (unreleased_set != NULL) *unreleased_set = (struct dpu_set_t){0};
+    if (allocation_owned != NULL) *allocation_owned = 0;
+    if (failure_error != NULL) *failure_error = DPU_OK;
+    if (allocation_used != NULL) *allocation_used = 0;
+    if (release_attempted != NULL) *release_attempted = 0;
+    if (release_succeeded != NULL) *release_succeeded = 0;
+    if (release_error_out != NULL) *release_error_out = DPU_OK;
+    if (num_dpus == 0 || allocation_profile == NULL ||
+        strcmp(allocation_profile, "backend=hw") != 0 ||
+        initialization_binary == NULL || initialization_binary[0] == '\0') {
+        if (failure_error != NULL) *failure_error = DPU_ERR_INVALID_PROFILE;
+        return NULL;
+    }
+    error = dpu_alloc(num_dpus, allocation_profile, &set);
+    if (error != DPU_OK) {
+        if (failure_error != NULL) *failure_error = error;
+        return NULL;
+    }
+    if (allocation_used != NULL) *allocation_used = 1;
+    error = dpu_load(set, initialization_binary, NULL);
+    if (error == DPU_OK) error = dpu_launch(set, DPU_SYNCHRONOUS);
+    if (error != DPU_OK) {
+        release_error = dpu_free(set);
+        if (release_attempted != NULL) *release_attempted = 1;
+        if (release_succeeded != NULL) *release_succeeded = release_error == DPU_OK;
+        if (release_error_out != NULL) *release_error_out = release_error;
+        if (release_error != DPU_OK) {
+            if (unreleased_set != NULL) *unreleased_set = set;
+            if (allocation_owned != NULL) *allocation_owned = 1;
+            if (failure_error != NULL) *failure_error = release_error;
+        } else if (failure_error != NULL) {
+            *failure_error = error;
+        }
+        return NULL;
+    }
+    simplepim_management_t* management = management_from_set(set, num_dpus);
+    if (management == NULL) {
+        release_error = dpu_free(set);
+        if (release_attempted != NULL) *release_attempted = 1;
+        if (release_succeeded != NULL) *release_succeeded = release_error == DPU_OK;
+        if (release_error_out != NULL) *release_error_out = release_error;
+        if (release_error != DPU_OK) {
+            if (unreleased_set != NULL) *unreleased_set = set;
+            if (allocation_owned != NULL) *allocation_owned = 1;
+            if (failure_error != NULL) *failure_error = release_error;
+        } else if (failure_error != NULL) {
+            *failure_error = DPU_ERR_ALLOCATION;
+        }
+        return NULL;
+    }
+    return management;
+}
 simplepim_management_t* table_management_init(uint32_t num_dpus){
